{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polley-enterprise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  // The Polley Enterprise account. Pinned so a deploy fails outright if a
  // different Cloudflare account is signed in, rather than publishing there.
  "account_id": "1f4b8a60146a3506526639512a6b0f05",
  "assets": {
    // Built by `npm run build` (Next.js static export).
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polley-enterprise",
      "database_id": "49473a60-7960-4d4d-8f74-173fd71eb513"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "petrucking96@gmail.com",
      "allowed_sender_addresses": ["quotes@polleyenterprise.com"]
    }
  ],
  "vars": {
    "SESSION_HOURS": "12",
    "NOTIFY_EMAIL": "petrucking96@gmail.com",
    "NOTIFY_FROM": "quotes@polleyenterprise.com"
  },
  "routes": [
    { "pattern": "polleyenterprise.com/*", "zone_name": "polleyenterprise.com" },
    { "pattern": "www.polleyenterprise.com/*", "zone_name": "polleyenterprise.com" }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
